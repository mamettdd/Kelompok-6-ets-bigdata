# Salin file ini ke `.env` (di repo root) lalu isi nilainya.
# File `.env` sudah masuk .gitignore — token tidak akan ke-commit.

# ===== AQICN (sumber API real-time) =====
# Daftar token gratis: https://aqicn.org/data-platform/token/
# Kalau dikosongkan, producer otomatis pakai SIMULATOR (acak realistis).
AQICN_TOKEN=a2c7dc8e5197f429236c0a0445fc84d3d3a9bfae

# Set 1 untuk paksa simulator meski token ada (mode demo offline)
FORCE_SIMULATOR=0

# ===== Kafka =====
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_API=airquality-api
KAFKA_TOPIC_RSS=airquality-rss

# Polling interval (detik). API: rubrik 15 menit (900). RSS: ubah sesuai kebutuhan.
#   Contoh rubrik lama: RSS tiap 5 menit (=300).
#   Contoh tiap ~bulan: RSS tiap 720 jam (= 2592000 detik, 30 hari).
POLL_INTERVAL_SEC=900
POLL_INTERVAL_SEC_RSS=2592000

# ===== HDFS =====
HDFS_NAMENODE_URL=http://localhost:9870
HDFS_NAMENODE_RPC=hdfs://localhost:9000
HDFS_USER=root
HDFS_BASE_DIR=/data/airquality
# Nama container namenode (untuk strategi docker_exec write)
HDFS_NAMENODE_CONTAINER=namenode
# Cara write file ke HDFS:
#   docker_exec  → pakai `docker exec namenode hdfs dfs -put -` (default, anti-WSL2 issue)
#   webhdfs      → pakai library hdfs Python langsung (butuh datanode hostname reachable)
HDFS_WRITE_MODE=docker_exec

# ===== Consumer buffering =====
# Flush ke HDFS setiap 180 detik (3 menit), atau saat 200 record terkumpul
BUFFER_FLUSH_SEC=180
BUFFER_MAX_RECORDS=200

# Consumer group id (tiap topic punya group sendiri)
CONSUMER_GROUP_API=airquality-consumer-api
CONSUMER_GROUP_RSS=airquality-consumer-rss

# ===== RSS feeds =====
# Delapan sumber: enam nasional + Kompas Sains/Lingkungan + Tempo tag polusi (tanpa detik.com).
# Producer hanya mengirim artikel yang cocok RSS_KEYWORDS (tema lingkungan).
# Kalau override, pisahkan dengan koma.
RSS_FEEDS="https://rss.kontan.co.id/news/nasional,https://feed.liputan6.com/rss/news,http://rss.tempo.co/nasional,https://www.cnbcindonesia.com/news/rss,https://www.cnnindonesia.com/nasional/rss,https://www.jawapos.com/nasional/rss,https://rss.kompas.com/feed/kompas.com/sains/environment,http://rss.tempo.co/tag/polusi"
RSS_KEYWORDS="polusi,udara,kualitas udara,lingkungan,aqi,emisi,asap,kabut,pencemaran,pm2.5,pm10,karhutla,iklim,perubahan iklim,cuaca ekstrem,banjir,sampah,plastik,energi terbarukan,hutan,limbah,nuklir,radiasi,rokok,vape"
# Tip: hapus baris RSS_KEYWORDS agar producer memakai ENV_KEYWORDS lengkap di producer_rss.py
# Top-N fallback bila tidak ada yang cocok keyword. Default 0 agar berita umum tidak tampil ke user.
RSS_FALLBACK_TOPN=0
# User-Agent untuk request RSS (beberapa server menolak default Python)
RSS_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AirQualityAlert/1.0"

# ===== Dashboard =====
PORT=5000
